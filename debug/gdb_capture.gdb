set pagination off
set confirm off
set disable-randomization off
echo \n[command] break add\n
break add
echo \n[command] run\n
run
echo \n[command] print a\n
print a
echo \n[command] print b\n
print b
echo \n[command] backtrace\n
backtrace
echo \n[command] next\n
next
echo \n[command] continue\n
continue
